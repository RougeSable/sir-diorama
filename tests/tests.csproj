<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of Sir Diorama. They cover the plugin's pure logic (Source/Logic),
    whose sources are included here: they run without the game and without
    Pulsar.

      dotnet test tests/tests.csproj

    ShaderCompilationTests also compiles the shader for real, with the Windows
    HLSL compiler and the game's own headers, when it finds them (SE_SHADERS,
    SE_BIN64, or a copy of the game next to the repository).
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>sir-diorama.tests</AssemblyName>
    <RootNamespace>SirDiorama.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Source\Logic\*.cs" Link="Logic\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

</Project>
